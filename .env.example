APP_PORT=8000
LOG_LEVEL=INFO
APP_IMAGE=dom-xss-pipeline:local
APP_DOMAIN=scan.example.com
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_HASH='$2a$14$replace_with_a_caddy_bcrypt_hash'

REDIS_URL=redis://redis:6379/0
QUEUE_NAME=domxss
WORKER_NAME=domxss-worker
MAX_QUEUED_SCANS=25
RESULT_TTL_SECONDS=86400
SCAN_JOB_TIMEOUT_SECONDS=1800

ALLOW_PRIVATE_TARGETS=false
MAX_PAGES=30
MAX_CRAWL_DEPTH=2
CRAWL_DELAY_MS=150
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_BYTES=5000000
MAX_SCRIPT_BYTES=2000000
INCLUDE_THIRD_PARTY_SCRIPTS=false
USER_AGENT=DOM-XSS-Pipeline/1.0

ML_MODEL_PATH=/app/artifacts/lightgbm_security_v2.txt
ML_VOCAB_PATH=/app/artifacts/vocab_security_v2.json
ML_THRESHOLD=0.50
ML_MAX_CODE_UNITS=500
ML_MAX_CODE_UNIT_BYTES=250000

ENABLE_ZAP=false
ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=replace-with-a-long-random-value
ZAP_MAX_MINUTES=10
ZAP_ATTACK_STRENGTH=LOW
ZAP_ALERT_THRESHOLD=MEDIUM

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
