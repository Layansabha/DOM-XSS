APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
QUEUE_NAME=domxss
RESULT_TTL_SECONDS=86400
SCAN_JOB_TIMEOUT_SECONDS=1800

ALLOW_PRIVATE_TARGETS=false
MAX_PAGES=30
MAX_CRAWL_DEPTH=2
CRAWL_DELAY_MS=150
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_BYTES=5000000
MAX_SCRIPT_BYTES=2000000
INCLUDE_THIRD_PARTY_SCRIPTS=false
USER_AGENT=DOM-XSS-Pipeline/1.0

ML_MODEL_PATH=/app/artifacts/random_forest_best_model_final.pkl
ML_VOCAB_PATH=/app/artifacts/vocab_top500_filtered.pkl
ML_THRESHOLD=0.50

ZAP_BASE_URL=http://zap:8080
ZAP_API_KEY=replace-with-a-long-random-value
ZAP_MAX_MINUTES=10
ZAP_ATTACK_STRENGTH=LOW
ZAP_ALERT_THRESHOLD=MEDIUM
